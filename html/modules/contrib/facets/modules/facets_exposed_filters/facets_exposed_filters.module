<?php

/**
 * @file
 * Contains facets_exposed_filters.module.
 */

use Drupal\Core\Block\BlockPluginInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\facets_exposed_filters\Hook\FacetsExposedFiltersHooks;
use Drupal\facets_exposed_filters\Hook\FacetsExposedFiltersThemeHooks;
use Drupal\search_api\Query\QueryInterface;
use Drupal\views\Plugin\views\filter\FilterPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_views_data_alter().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_views_data_alter(array &$data): void {
  \Drupal::classResolver(FacetsExposedFiltersHooks::class)->viewsDataAlter($data);
}

/**
 * Implements hook_search_api_query_alter().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_search_api_query_alter(QueryInterface $query): void {
  \Drupal::classResolver(FacetsExposedFiltersHooks::class)->searchApiQueryAlter($query);
}

/**
 * Implements hook_views_post_execute().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_views_post_execute(ViewExecutable $view): void {
  \Drupal::classResolver(FacetsExposedFiltersHooks::class)->viewsPostExecute($view);
}

/**
 * Implements hook_views_filters_summary_info_alter().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_views_filters_summary_info_alter(array &$info, FilterPluginBase $filter): void {
  \Drupal::classResolver(FacetsExposedFiltersHooks::class)->viewsFiltersSummaryInfoAlter($info, $filter);
}

/**
 * Implements hook_block_build_alter().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_block_build_alter(array &$build, BlockPluginInterface $block): void {
  \Drupal::classResolver(FacetsExposedFiltersHooks::class)->blockBuildAlter($build, $block);
}

/**
 * Implements hook_preprocess_bef_checkboxes().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_preprocess_bef_checkboxes(array &$variables): void {
  \Drupal::classResolver(FacetsExposedFiltersThemeHooks::class)->preprocessBefCheckboxes($variables);
}

/**
 * Implements hook_preprocess_bef_radios().
 */
// @phpstan-ignore-next-line
#[LegacyHook]
function facets_exposed_filters_preprocess_bef_radios(array &$variables): void {
  \Drupal::classResolver(FacetsExposedFiltersThemeHooks::class)->preprocessBefRadios($variables);
}
